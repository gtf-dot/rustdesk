# Copy to `.env` (git-ignored) to bake your own server into the build.
# build_linux.sh, build_mac.sh and build_windows.ps1 export these before
# running cargo; hbb_common reads them with option_env!() at compile time.
# Variables already set in the shell take precedence over this file, so
# CI secrets keep working unchanged.

# hbbs address, host only or host:port (default port 21116)
RENDEZVOUS_SERVERS=your.server.example.com

# Contents of the server's id_ed25519.pub
RS_PUB_KEY=
